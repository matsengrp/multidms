"""Snakemake workflow for the simulation validation pipeline.

Five notebooks executed via papermill:
  simulate_data → fit_models → evaluate          ⟩→ manuscript_figures
                             → cross_validation  ⟩

evaluate and cross_validation run in parallel after fit_models.

Run with:
  snakemake -s experiments/simulation/Snakefile -j4
  snakemake -s experiments/simulation/Snakefile --config profile=test -j4
"""

import os
import yaml

# Resolve paths relative to the Snakefile location
SIM_DIR = os.path.dirname(workflow.snakefile)
NOTEBOOKS = os.path.join(SIM_DIR, "notebooks")

# Config: use test profile if --config profile=test is passed
profile = config.get("profile", None)
if profile == "test":
    CONFIG_PATH = os.path.join(SIM_DIR, "config", "config_test.yaml")
else:
    CONFIG_PATH = os.path.join(SIM_DIR, "config", "config.yaml")

# Downstream tier: derived from whatever path the profile logic resolved.
# Declared as an input ONLY on downstream rules, so editing it cannot
# invalidate the cached fit. See issue #287.
DOWNSTREAM_CONFIG_PATH = CONFIG_PATH.replace(".yaml", "_downstream.yaml")

# Read output_dir from the YAML config so test profiles can isolate results
with open(CONFIG_PATH) as _f:
    _cfg = yaml.safe_load(_f)
# CLI override (--config output_dir=...) takes precedence over YAML
_yaml_output_dir = _cfg.get("simulation", {}).get("output_dir", "results")
output_dir = config.get("output_dir", _yaml_output_dir)
RESULTS = os.path.join(SIM_DIR, output_dir)
FIGURES = os.path.join(RESULTS, "figures")

# Relative config path for papermill parameter injection — avoids
# leaking absolute server paths into executed notebook metadata.
CONFIG_PATH_REL = os.path.relpath(CONFIG_PATH, SIM_DIR)
DOWNSTREAM_CONFIG_PATH_REL = os.path.relpath(DOWNSTREAM_CONFIG_PATH, SIM_DIR)


rule all:
    input:
        os.path.join(RESULTS, "manuscript_figures.ipynb"),
        os.path.join(RESULTS, "cross_validation.ipynb"),
        os.path.join(FIGURES, "main_figure.pdf"),
        os.path.join(FIGURES, "ground_truth_correlation.pdf"),
        os.path.join(FIGURES, "sparsity_diagnostic.pdf"),


rule simulate_data:
    input:
        config=CONFIG_PATH,
        notebook=os.path.join(NOTEBOOKS, "simulate_data.ipynb"),
    output:
        muteffects=os.path.join(RESULTS, "simulated_muteffects.csv"),
        func_scores=os.path.join(RESULTS, "simulated_func_scores.csv"),
        executed_notebook=os.path.join(RESULTS, "simulate_data.ipynb"),
    params:
        config_path=CONFIG_PATH_REL,
        output_dir=output_dir,
    shell:
        """
        papermill {input.notebook} {output.executed_notebook} \
            -p config_path {params.config_path} \
            -p output_dir {params.output_dir} \
            --cwd {SIM_DIR} \
        && jupyter trust {output.executed_notebook}
        """


rule fit_models:
    input:
        config=CONFIG_PATH,
        func_scores=os.path.join(RESULTS, "simulated_func_scores.csv"),
        notebook=os.path.join(NOTEBOOKS, "fit_models.ipynb"),
    output:
        fit_collection=os.path.join(RESULTS, "fit_collection.pkl"),
        executed_notebook=os.path.join(RESULTS, "fit_models.ipynb"),
    params:
        config_path=CONFIG_PATH_REL,
        output_dir=output_dir,
    shell:
        """
        papermill {input.notebook} {output.executed_notebook} \
            -p config_path {params.config_path} \
            -p output_dir {params.output_dir} \
            --cwd {SIM_DIR} \
        && jupyter trust {output.executed_notebook}
        """


rule evaluate:
    input:
        config=CONFIG_PATH,
        downstream_config=DOWNSTREAM_CONFIG_PATH,
        fit_collection=os.path.join(RESULTS, "fit_collection.pkl"),
        muteffects=os.path.join(RESULTS, "simulated_muteffects.csv"),
        func_scores=os.path.join(RESULTS, "simulated_func_scores.csv"),
        notebook=os.path.join(NOTEBOOKS, "evaluate.ipynb"),
    output:
        model_vs_truth=os.path.join(
            RESULTS, "model_vs_truth_beta_shift.csv"
        ),
        collection_muts=os.path.join(RESULTS, "collection_muts.csv"),
        sparsity=os.path.join(RESULTS, "fit_sparsity.csv"),
        replicate_corr=os.path.join(
            RESULTS, "library_replicate_correlation.csv"
        ),
        phenotype=os.path.join(
            RESULTS, "model_vs_truth_variant_phenotype.csv"
        ),
        executed_notebook=os.path.join(RESULTS, "evaluate.ipynb"),
    params:
        config_path=CONFIG_PATH_REL,
        downstream_config_path=DOWNSTREAM_CONFIG_PATH_REL,
        output_dir=output_dir,
    shell:
        """
        papermill {input.notebook} {output.executed_notebook} \
            -p config_path {params.config_path} \
            -p downstream_config_path {params.downstream_config_path} \
            -p output_dir {params.output_dir} \
            --cwd {SIM_DIR} \
        && jupyter trust {output.executed_notebook}
        """


rule cross_validation:
    input:
        config=CONFIG_PATH,
        func_scores=os.path.join(RESULTS, "simulated_func_scores.csv"),
        notebook=os.path.join(NOTEBOOKS, "cross_validation.ipynb"),
    output:
        cv_loss=os.path.join(RESULTS, "cross_validation_loss.csv"),
        executed_notebook=os.path.join(RESULTS, "cross_validation.ipynb"),
    params:
        config_path=CONFIG_PATH_REL,
        output_dir=output_dir,
    shell:
        """
        papermill {input.notebook} {output.executed_notebook} \
            -p config_path {params.config_path} \
            -p output_dir {params.output_dir} \
            --cwd {SIM_DIR} \
        && jupyter trust {output.executed_notebook}
        """


rule manuscript_figures:
    input:
        config=CONFIG_PATH,
        downstream_config=DOWNSTREAM_CONFIG_PATH,
        muteffects=os.path.join(RESULTS, "simulated_muteffects.csv"),
        func_scores=os.path.join(RESULTS, "simulated_func_scores.csv"),
        model_vs_truth=os.path.join(
            RESULTS, "model_vs_truth_beta_shift.csv"
        ),
        collection_muts=os.path.join(RESULTS, "collection_muts.csv"),
        sparsity=os.path.join(RESULTS, "fit_sparsity.csv"),
        replicate_corr=os.path.join(
            RESULTS, "library_replicate_correlation.csv"
        ),
        phenotype=os.path.join(
            RESULTS, "model_vs_truth_variant_phenotype.csv"
        ),
        cv_loss=os.path.join(RESULTS, "cross_validation_loss.csv"),
        notebook=os.path.join(NOTEBOOKS, "manuscript_figures.ipynb"),
    output:
        executed_notebook=os.path.join(
            RESULTS, "manuscript_figures.ipynb"
        ),
        main_figure=os.path.join(FIGURES, "main_figure.pdf"),
        ground_truth=os.path.join(
            FIGURES, "ground_truth_correlation.pdf"
        ),
        sparsity_diag=os.path.join(FIGURES, "sparsity_diagnostic.pdf"),
    params:
        config_path=CONFIG_PATH_REL,
        downstream_config_path=DOWNSTREAM_CONFIG_PATH_REL,
        output_dir=output_dir,
    shell:
        """
        papermill {input.notebook} {output.executed_notebook} \
            -p config_path {params.config_path} \
            -p downstream_config_path {params.downstream_config_path} \
            -p output_dir {params.output_dir} \
            --cwd {SIM_DIR} \
        && jupyter trust {output.executed_notebook}
        """
